# AI Teleprompter — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Claude (Anthropic) — Initial provider
CLAUDE_API_KEY=

# OpenAI (future support)
OPENAI_API_KEY=

# Google Gemini (future support)
GEMINI_API_KEY=

# ─── STT Provider ─────────────────────────────────────────────────────────────
# Deepgram — Initial streaming STT provider
DEEPGRAM_API_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
AI_PROVIDER=claude
STT_PROVIDER=none

# ─── Backend ──────────────────────────────────────────────────────────────────
# IMPORTANT: Always use 127.0.0.1, never 0.0.0.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# ─── Development ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
DEBUG=false
