{
  "name": "ai-teleprompter",
  "version": "0.1.0",
  "description": "Transparent AI Teleprompter Desktop Application",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit -p desktop/electron/tsconfig.json && tsc --noEmit -p desktop/renderer/tsconfig.json",
    "lint": "eslint desktop --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "author": "Diwakar Pratap",
  "build": {
    "appId": "com.aiteleprompter.app",
    "productName": "AI Teleprompter",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.pytest_cache/**"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "legalTrademarks": "Diwakar Pratap",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "AI-Teleprompter-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "zustand": "^4.5.7"
  }
}
